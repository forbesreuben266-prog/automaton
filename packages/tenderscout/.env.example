# ---- Safety switches (defaults are safe) ----
TS_DRY_RUN=true                 # true = emails written to data/outbox, nothing sent. Set false ONLY after approval.
TS_ALLOW_LIVE_PAYMENTS=false    # sk_live_ keys are refused unless true.

# ---- Site ----
TS_BASE_URL=https://www.tenderscout.co.uk
PORT=3000
TS_DATA_DIR=./data              # SQLite DB + outbox; must be on a persistent disk
TS_CONTACT_EMAIL=hello@tenderscout.co.uk
TS_ADMIN_EMAIL=you@yourdomain.co.uk      # failure alerts go here
TS_COMPANY_LEGAL_NAME=Your Company Ltd
TS_COMPANY_ADDRESS=1 Example Street, Town, AB1 2CD
TS_COMPANY_NUMBER=
TS_ICO_NUMBER=

# ---- Email (any SMTP provider: Postmark, Resend, Brevo, SES...) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TS_FROM_EMAIL=TenderScout UK <alerts@tenderscout.co.uk>

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...       # £29/month recurring price
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Optional ----
TS_SCAN_LOOKBACK_DAYS=3
TS_RETENTION_DAYS=180
